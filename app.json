{
  "expo": {
    "name": "Resty",
    "slug": "resty",
    "version": "1.2.0",
    "orientation": "portrait",
    "scheme": "resty",
    "icon": "./assets/images/AppIcon-1024-green.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/ios_dark_portrait_1284x2778.png",
      "resizeMode": "contain",
      "backgroundColor": "#072A2D"
    },
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "userInterfaceStyle": "automatic",
      "bundleIdentifier": "com.resty.restyapp",
      "icon": "./assets/images/AppIcon-1024-green.png",
      "splash": {
        "image": "./assets/images/ios_light_portrait_1284x2778.png",
        "resizeMode": "contain",
        "backgroundColor": "#072A2D",
        "dark": {
          "image": "./assets/images/ios_dark_portrait_1284x2778.png",
          "resizeMode": "contain",
          "backgroundColor": "#072A2D"
        },
        "light": {
          "image": "./assets/images/ios_light_portrait_1284x2778.png",
          "resizeMode": "contain",
          "backgroundColor": "#072A2D"
        }
      },
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.769679276829-og604t40g8f121sikec8vtpogmkq6iie",
              "resty",
              "com.resty.restyapp"
            ]
          }
        ],
        "CFBundleAllowMixedLocalizations": true,
        "NSFaceIDUsageDescription": "Autorizar Face ID.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      },
      "associatedDomains": [
        "applinks:resty.com"
      ],
      "appleTeamId": "P98BMU72AA"
    },
    "android": {
      "icon": "./assets/images/AppIcon-1024-light.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/android/ic_launcher_foreground.png",
        "backgroundColor": "#072A2D",
        "monochromeImage": "./assets/icons/android/ic_launcher_foreground.png"
      },
      "splash": {
        "image": "./assets/images/android_light_portrait_1080x2340.png",
        "resizeMode": "contain",
        "backgroundColor": "#072A2D",
        "dark": {
          "image": "./assets/images/android_dark_portrait_1080x2340.png",
          "resizeMode": "contain",
          "backgroundColor": "#072A2D"
        }
      },
      "package": "com.resty.restyapp",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "androidStatusBar": {
      "backgroundColor": "#072A2D",
      "barStyle": "light-content",
      "translucent": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.769679276829-og604t40g8f121sikec8vtpogmkq6iie",
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "minSdkVersion": 23
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Resty to use Face ID."
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/PlusJakartaSans-Regular.ttf",
            "./assets/fonts/PlusJakartaSans-Bold.ttf",
            "./assets/fonts/PlusJakartaSans-Medium.ttf",
            "./assets/fonts/PlusJakartaSans-SemiBold.ttf",
            "./assets/fonts/PlusJakartaSans-ExtraBold.ttf",
            "./assets/fonts/PlusJakartaSans-Black.ttf",
            "./assets/fonts/PlusJakartaSans-Light.ttf",
            "./assets/fonts/PlusJakartaSans-ExtraLight.ttf",
            "./assets/fonts/PlusJakartaSans-Thin.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/PlusJakartaSans-ExtraLight.ttf",
                    "weight": 100,
                    "style": "thin"
                  },
                  {
                    "path": "./assets/fonts/PlusJakartaSans-Light.ttf",
                    "weight": 300,
                    "style": "light"
                  },
                  {
                    "path": "./assets/fonts/PlusJakartaSans-Regular.ttf",
                    "weight": 400,
                    "style": "normal"
                  },
                  {
                    "path": "./assets/fonts/PlusJakartaSans-Medium.ttf",
                    "weight": 500,
                    "style": "medium"
                  },
                  {
                    "path": "./assets/fonts/PlusJakartaSans-SemiBold.ttf",
                    "weight": 600,
                    "style": "semiBold"
                  },
                  {
                    "path": "./assets/fonts/PlusJakartaSans-Bold.ttf",
                    "weight": 700,
                    "style": "bold"
                  },
                  {
                    "path": "./assets/fonts/PlusJakartaSans-ExtraBold.ttf",
                    "weight": 800,
                    "style": "extraBold"
                  },
                  {
                    "path": "./assets/fonts/PlusJakartaSans-Black.ttf",
                    "weight": 900,
                    "style": "black"
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/PlusJakartaSans-Regular.ttf",
              "./assets/fonts/PlusJakartaSans-Bold.ttf",
              "./assets/fonts/PlusJakartaSans-Medium.ttf",
              "./assets/fonts/PlusJakartaSans-SemiBold.ttf",
              "./assets/fonts/PlusJakartaSans-ExtraBold.ttf",
              "./assets/fonts/PlusJakartaSans-Black.ttf",
              "./assets/fonts/PlusJakartaSans-Light.ttf",
              "./assets/fonts/PlusJakartaSans-ExtraLight.ttf",
              "./assets/fonts/PlusJakartaSans-Thin.ttf"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "3089e8fc-9f1d-461d-93de-f8bdaccebb25"
      }
    },
    "owner": "rodrwan"
  }
}