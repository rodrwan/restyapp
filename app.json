{
  "expo": {
    "name": "Mangoticket",
    "slug": "mangoticket",
    "version": "1.2.0",
    "orientation": "portrait",
    "scheme": "mangoticket",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#041e2b"
    },
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "userInterfaceStyle": "automatic",
      "bundleIdentifier": "com.mangoticket.mangoticketapp",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.769679276829-og604t40g8f121sikec8vtpogmkq6iie",
              "mangoticket",
              "com.mangoticket.mangoticketapp"
            ]
          }
        ],
        "CFBundleAllowMixedLocalizations": true,
        "NSFaceIDUsageDescription": "Autorizar Face ID.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      },
      "associatedDomains": [
        "applinks:spotlight.mangoticket.com"
      ],
      "appleTeamId": "P98BMU72AA"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.mangoticketapp.mangoticketapp",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.769679276829-og604t40g8f121sikec8vtpogmkq6iie",
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "buildToolsVersion": "34.0.0"
          }
        }
      ],
      "expo-build-properties",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Mangoticket to use Face ID."
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "3089e8fc-9f1d-461d-93de-f8bdaccebb25"
      }
    },
    "owner": "rodrwan"
  }
}